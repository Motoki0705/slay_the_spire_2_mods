# Secrets and local environments
.env
.env.*
!.env.example
*.env
.venv/
__pycache__/
*.pyc

# Build/tool scratch
tmp/
.cache/
**/bin/
**/obj/
**/node_modules/
**/.godot/
dist/

# Raw resources extracted from the user's installed game: local evidence only.
docs/research/motion/evidence/resources/
docs/research/motion/evidence/*.il.txt
docs/research/implementation/evidence/*.il.txt
docs/research/implementation/evidence/rig-reuse/resources/
art/references/*/official/game-assets/*.ctex

# Never vendor the installed game's libraries into the mod/repository.
*.dll
*.pdb
*.nupkg

# Issue #7 local build receipts (SDK/cache stays outside the repository).
/mod/build/

# Texture imports are regenerated by the PCK builder in its isolated stage.
/mod/assets/**/*.png.import
